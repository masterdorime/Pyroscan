# PyroScan provider keys. Copy to .env and fill in. Never commit .env.
# Every value here is optional; missing keys disable that provider, nothing else.

# NASA FIRMS area API key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
PYROSCAN_FIRMS_MAP_KEY=

# Manual BMKG adm4 override. Leave empty to auto-resolve from the bundled index.
PYROSCAN_BMKG_ADM4=

# Regional ring around the mission, in km. Clamped to 10-25.
PYROSCAN_REGIONAL_RING_KM=15

# Set to 1 to forbid all outbound provider requests (serve cache only).
PYROSCAN_PROVIDER_OFFLINE=0

# Not used by Phase 1-5. Documented so nobody adds an account "just in case".
PYROSCAN_EARTHDATA_TOKEN=
PYROSCAN_CDSE_CLIENT_ID=
PYROSCAN_CDSE_SECRET=
